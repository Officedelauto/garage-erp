// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Réglages de l'entreprise (mono-garage pour le MVP)
// -----------------------------------------------------------------------------
model Company {
  id                   String         @id @default(cuid())
  name                 String
  address              String
  postalCode           String
  city                 String
  siret                String
  vatNumber            String?
  phone                String?
  email                String?
  iban                 String?
  logoUrl              String?
  quotePrefix          String         @default("DEV")
  invoicePrefix        String         @default("FA")
  orderPrefix          String         @default("BC")
  creditNotePrefix     String         @default("AV")
  nextQuoteNumber      Int            @default(1)
  nextInvoiceNumber    Int            @default(1)
  nextOrderNumber      Int            @default(1)
  nextCreditNoteNumber Int            @default(1)
  // Modèle de mise en page utilisé pour l'affiche prix PDF des véhicules.
  posterTemplate       PosterTemplate @default(CLASSIQUE)
  // Jeton secret utilisé dans l'URL du flux iCal (abonnement Google Agenda en lecture seule).
  calendarFeedToken    String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
}

enum PosterTemplate {
  CLASSIQUE
  MODERNE
  MINIMALISTE
  ETIQUETTE
  TABLEAU
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())

  appointments Appointment[]
}

enum ClientType {
  PARTICULIER
  PROFESSIONNEL
}

model Client {
  id          String     @id @default(cuid())
  type        ClientType @default(PARTICULIER)
  firstName   String?
  lastName    String?
  companyName String?
  siret       String?
  email       String?
  phone       String?
  address     String?
  postalCode  String?
  city        String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  vehicles            Vehicle[]
  vehicleReservations Vehicle[]     @relation("VehicleReservation")
  documents           Document[]
  appointments        Appointment[]
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
  GPL
  AUTRE
}

enum PaymentMethod {
  ESPECES
  CARTE
  CHEQUE
  VIREMENT
  AUTRE
}

model Vehicle {
  id                      String      @id @default(cuid())
  clientId                String?
  client                  Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  plate                   String      @unique
  stockNumber             String?
  brand                   String
  model                   String
  trim                    String?
  color                   String?
  vin                     String?
  firstRegistrationDate   DateTime?
  technicalInspectionDate DateTime?
  fiscalHorsepower        Int?
  co2Emissions            Int?
  mileage                 Int?
  fuelType                FuelType    @default(AUTRE)
  transmission            String?
  warranty                String?
  purchaseDate            DateTime?
  purchasePrice           Decimal?    @db.Decimal(10, 2)
  sellerType              ClientType?
  sellerName              String?
  salePrice               Decimal?    @db.Decimal(10, 2)
  // Date de vente effective, pour le livre de police (registre des objets mobiliers).
  saleDate                DateTime?
  options                 String[]    @default([])
  adCopy                  String?     @db.Text
  notes                   String?

  // Réservation (acompte versé, véhicule en cours de livraison à un client identifié).
  reservedByClientId   String?
  reservedByClient     Client?        @relation("VehicleReservation", fields: [reservedByClientId], references: [id], onDelete: SetNull)
  depositAmount        Decimal?       @db.Decimal(10, 2)
  depositPaymentMethod PaymentMethod?
  depositDate          DateTime?
  reservationOrderId   String?
  reservationOrder     Document?      @relation("VehicleReservationOrder", fields: [reservationOrderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     Document[]
  documentLines DocumentLine[] @relation("DocumentLineVehicle")
  notesLog      VehicleNote[]
  photos        VehiclePhoto[]
  appointments  Appointment[]
}

model VehicleNote {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  content     String
  mileage     Int?
  performedAt DateTime?
  source      String    @default("manual")
  createdAt   DateTime  @default(now())
}

model VehiclePhoto {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StockItem {
  id              String   @id @default(cuid())
  reference       String   @unique
  name            String
  description     String?
  purchasePriceHT Decimal  @db.Decimal(10, 2)
  salePriceHT     Decimal  @db.Decimal(10, 2)
  vatRate         Decimal  @default(20) @db.Decimal(5, 2)
  quantity        Int      @default(0)
  alertThreshold  Int      @default(1)
  unit            String   @default("unité")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  documentLines DocumentLine[]
}

// Catalogue d'articles et prestations facturables sans suivi de quantité
// (main d'œuvre, livraison, frais de carte grise, etc.), géré depuis les réglages
// et utilisé comme raccourci de remplissage des lignes de devis/factures.
model ServiceItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  priceHT     Decimal  @db.Decimal(10, 2)
  vatRate     Decimal  @default(20) @db.Decimal(5, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DocumentKind {
  QUOTE
  ORDER
  INVOICE
  CREDIT_NOTE
}

enum DocumentStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

model Document {
  id     String         @id @default(cuid())
  kind   DocumentKind
  number String?        @unique
  status DocumentStatus @default(DRAFT)

  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id])

  issueDate DateTime?
  dueDate   DateTime?
  paidAt    DateTime?

  // Copie des mentions légales de l'entreprise au moment de l'émission,
  // pour garder une facture immuable même si les réglages changent ensuite.
  companySnapshot Json?

  notes String?

  totalHT  Decimal @default(0) @db.Decimal(10, 2)
  totalTVA Decimal @default(0) @db.Decimal(10, 2)
  totalTTC Decimal @default(0) @db.Decimal(10, 2)

  // Acompte (principalement utilisé sur un bon de commande pour réserver un véhicule).
  depositAmount        Decimal?       @db.Decimal(10, 2)
  depositPaymentMethod PaymentMethod?

  convertedFromQuoteId String?   @unique
  convertedFromQuote   Document? @relation("QuoteToInvoice", fields: [convertedFromQuoteId], references: [id])
  convertedInvoice     Document? @relation("QuoteToInvoice")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            DocumentLine[]
  reservedVehicles Vehicle[]      @relation("VehicleReservationOrder")

  @@index([kind, status])
}

enum LineType {
  PART
  LABOR
  VEHICLE
  OTHER
}

model DocumentLine {
  id          String     @id @default(cuid())
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type        LineType   @default(OTHER)
  description String
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?   @relation("DocumentLineVehicle", fields: [vehicleId], references: [id])
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPriceHT Decimal    @db.Decimal(10, 2)
  vatRate     Decimal    @default(20) @db.Decimal(5, 2)
  position    Int        @default(0)
}

enum AppointmentType {
  REVISION
  REPARATION
  CONTROLE_TECHNIQUE
  LIVRAISON
  ESSAI
  AUTRE
}

model Appointment {
  id      String          @id @default(cuid())
  title   String
  type    AppointmentType @default(AUTRE)
  startAt DateTime
  endAt   DateTime?

  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startAt])
}
