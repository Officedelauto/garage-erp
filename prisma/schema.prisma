// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Réglages de l'entreprise (mono-garage pour le MVP)
// -----------------------------------------------------------------------------
model Company {
  id               String   @id @default(cuid())
  name             String
  address          String
  postalCode       String
  city             String
  siret            String
  vatNumber        String?
  phone            String?
  email            String?
  iban             String?
  quotePrefix      String   @default("DEV")
  invoicePrefix    String   @default("FA")
  nextQuoteNumber  Int      @default(1)
  nextInvoiceNumber Int     @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum UserRole {
  ADMIN
  STAFF
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(STAFF)
  createdAt    DateTime @default(now())
}

enum ClientType {
  PARTICULIER
  PROFESSIONNEL
}

model Client {
  id          String     @id @default(cuid())
  type        ClientType @default(PARTICULIER)
  firstName   String?
  lastName    String?
  companyName String?
  siret       String?
  email       String?
  phone       String?
  address     String?
  postalCode  String?
  city        String?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  vehicles  Vehicle[]
  documents Document[]
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
  GPL
  AUTRE
}

model Vehicle {
  id            String    @id @default(cuid())
  clientId      String
  client        Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plate         String    @unique
  brand         String
  model         String
  vin           String?
  year          Int?
  mileage       Int?
  fuelType      FuelType  @default(AUTRE)
  purchasePrice Decimal?  @db.Decimal(10, 2)
  salePrice     Decimal?  @db.Decimal(10, 2)
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  documents Document[]
  notesLog  VehicleNote[]
}

model VehicleNote {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  content   String
  source    String   @default("manual")
  createdAt DateTime @default(now())
}

model StockItem {
  id             String   @id @default(cuid())
  reference      String   @unique
  name           String
  description    String?
  purchasePriceHT Decimal @db.Decimal(10, 2)
  salePriceHT    Decimal  @db.Decimal(10, 2)
  vatRate        Decimal  @default(20) @db.Decimal(5, 2)
  quantity       Int      @default(0)
  alertThreshold Int      @default(1)
  unit           String   @default("unité")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  documentLines DocumentLine[]
}

enum DocumentKind {
  QUOTE
  INVOICE
}

enum DocumentStatus {
  DRAFT
  FINALIZED
  PAID
  CANCELLED
}

model Document {
  id          String         @id @default(cuid())
  kind        DocumentKind
  number      String?        @unique
  status      DocumentStatus @default(DRAFT)

  clientId    String
  client      Client         @relation(fields: [clientId], references: [id])
  vehicleId   String?
  vehicle     Vehicle?       @relation(fields: [vehicleId], references: [id])

  issueDate   DateTime?
  dueDate     DateTime?
  paidAt      DateTime?

  // Copie des mentions légales de l'entreprise au moment de l'émission,
  // pour garder une facture immuable même si les réglages changent ensuite.
  companySnapshot Json?

  notes       String?

  totalHT     Decimal        @default(0) @db.Decimal(10, 2)
  totalTVA    Decimal        @default(0) @db.Decimal(10, 2)
  totalTTC    Decimal        @default(0) @db.Decimal(10, 2)

  convertedFromQuoteId String? @unique
  convertedFromQuote   Document? @relation("QuoteToInvoice", fields: [convertedFromQuoteId], references: [id])
  convertedInvoice     Document? @relation("QuoteToInvoice")

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  lines DocumentLine[]

  @@index([kind, status])
}

enum LineType {
  PART
  LABOR
  OTHER
}

model DocumentLine {
  id          String     @id @default(cuid())
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type        LineType   @default(OTHER)
  description String
  stockItemId String?
  stockItem   StockItem? @relation(fields: [stockItemId], references: [id])
  quantity    Decimal    @default(1) @db.Decimal(10, 2)
  unitPriceHT Decimal    @db.Decimal(10, 2)
  vatRate     Decimal    @default(20) @db.Decimal(5, 2)
  position    Int        @default(0)
}
